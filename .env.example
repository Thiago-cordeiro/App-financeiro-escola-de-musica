# Copie este arquivo para .env para personalizar o ambiente local.
POSTGRES_DB=gestao_pagamentos
POSTGRES_USER=gestao_app
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_PORT=5432
APP_PORT=8080
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# JWT RSA (Base64 do DER X.509 público e PKCS#8 privado; nunca versione valores reais)
JWT_GENERATE_KEY_PAIR=false
JWT_PUBLIC_KEY=cole_a_chave_publica_base64_aqui
JWT_PRIVATE_KEY=cole_a_chave_privada_base64_aqui
JWT_ISSUER=gestao-pagamentos-api
JWT_AUDIENCE=gestao-pagamentos-api
JWT_ACCESS_TOKEN_EXPIRATION=PT1H

# Origens autorizadas, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Bootstrap opcional e idempotente do primeiro administrador
ADMIN_INITIAL_ENABLED=false
ADMIN_INITIAL_NAME=Administrador
ADMIN_INITIAL_EMAIL=admin@exemplo.com
ADMIN_INITIAL_PASSWORD=troque-por-uma-senha-segura

# Endpoint público temporário; defina como false antes de publicar.
TEST_ADMIN_ENDPOINT_ENABLED=true
